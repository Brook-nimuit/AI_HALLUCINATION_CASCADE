{
  "name": "hallucination-cascade-site",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:chess-review",
    "build:css": "tailwindcss --input ./web/assets/tailwind.css --output ./web/assets/app.css --minify",
    "build:chess-review": "vite build --config vite.chess-review.config.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.0.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.6"
  }
}
